{
    "printWidth": 120,
    "trailingComma": "all",
    "tabWidth": 4,
    "useTabs": false,
    "endOfLine": "crlf",
    "semi": true,
    "singleQuote": true,
    "jsxSingleQuote": false,
    "bracketSpacing": true,
    "jsxBracketSameLine": false,
    "arrowParens": "avoid",
    "plugins": ["prettier-plugin-tailwindcss"]
}
