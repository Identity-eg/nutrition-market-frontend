{
	"trailingComma": "es5",
	"tabWidth": 2,
	"useTabs": true,
	"endOfLine": "crlf",
	"quoteProps": "as-needed",
	"semi": true,
	"singleQuote": true,
	"jsxSingleQuote": false,
	"bracketSpacing": true,
	"jsxBracketSameLine": true,
	"arrowParens": "avoid",
	"singleAttributePerLine": true,
	"plugins": ["prettier-plugin-tailwindcss"]
}
